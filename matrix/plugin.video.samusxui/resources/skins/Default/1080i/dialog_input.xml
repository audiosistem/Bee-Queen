<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <defaultcontrol>100</defaultcontrol>
    <controls>

        <!-- Overlay scrim -->
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="B0000000">white.png</texture>
        </control>

        <!-- Chenar violet 2px -->
        <control type="image">
            <left>578</left><top>418</top><width>764</width><height>232</height>
            <colordiffuse>FF7B5CF4</colordiffuse>
            <texture border="16">panel_rounded.png</texture>
        </control>

        <!-- Card bg -->
        <control type="image">
            <left>580</left><top>420</top><width>760</width><height>228</height>
            <colordiffuse>FF141428</colordiffuse>
            <texture border="16">panel_rounded.png</texture>
        </control>

        <!-- Titlu (setat din Python) -->
        <control type="label" id="10">
            <left>596</left><top>434</top><width>728</width><height>36</height>
            <label>Input</label>
            <font>font20</font>
            <textcolor>FFFFFFFF</textcolor>
            <align>center</align>
        </control>

        <!-- Separator -->
        <control type="image">
            <left>596</left><top>476</top><width>728</width><height>1</height>
            <texture colordiffuse="1AFFFFFF">white.png</texture>
        </control>

        <!-- Edit control -->
        <control type="edit" id="100">
            <left>596</left><top>482</top><width>728</width><height>52</height>
            <font>font20</font>
            <textcolor>FFFFFFFF</textcolor>
            <hinttext>Introduceți valoarea...</hinttext>
            <texturedefault  colordiffuse="FF141428">white.png</texturedefault>
            <texturenofocus  colordiffuse="FF141428">white.png</texturenofocus>
            <texturefocus    colordiffuse="FF141428">white.png</texturefocus>
            <ondown>1</ondown>
        </control>

        <!-- Buton OK -->
        <control type="button" id="1">
            <left>596</left><top>544</top><width>356</width><height>52</height>
            <label>OK</label>
            <font>font20</font>
            <textcolor>FF888899</textcolor>
            <focusedcolor>FFFFFFFF</focusedcolor>
            <texturefocus   colordiffuse="FF7B5CF4">white.png</texturefocus>
            <texturenofocus colordiffuse="22FFFFFF">white.png</texturenofocus>
            <align>center</align>
            <onup>100</onup>
            <onright>2</onright>
        </control>

        <!-- Buton Anulează -->
        <control type="button" id="2">
            <left>964</left><top>544</top><width>356</width><height>52</height>
            <label>Anulează</label>
            <font>font20</font>
            <textcolor>FF888899</textcolor>
            <focusedcolor>FFFFFFFF</focusedcolor>
            <texturefocus   colordiffuse="FFCC2233">white.png</texturefocus>
            <texturenofocus colordiffuse="22FFFFFF">white.png</texturenofocus>
            <align>center</align>
            <onup>100</onup>
            <onleft>1</onleft>
        </control>

    </controls>
</window>
