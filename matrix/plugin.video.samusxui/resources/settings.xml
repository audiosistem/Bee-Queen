<settings>
    <category label="Interfață" id="interface">

        <setting id="ui_mode" type="labelenum" label="Mod interfață" values="SamusXUI|Nativ (skin)" default="SamusXUI" />
    </category>
    <category label="Redare" id="playback">

        <setting id="resolver_timeout" type="number" label="Timeout rezolvare surse (secunde)" default="10" />
        <setting id="history_enabled" type="bool" label="Activează istoricul vizionărilor" default="true" />
        <setting id="autoplay_next" type="bool" label="Auto-play episod următor" default="true" />
        <setting id="autoplay_countdown" type="number" label="Numărătoare inversă (30 secunde)" default="30" visible="eq(-1,true)" enable="false" />
        <setting id="auto_select_provider" type="bool" label="Auto-selectează providerul memorat (sare dialogul de surse)" default="true" />
        <setting id="trailer_autoplay" type="bool" label="Pornește trailerul automat pe titlul selectat" default="true" />
        <setting id="trailer_autoplay_delay" type="number" label="Secunde de așteptare pe titlu înainte de trailer" default="5" visible="eq(-1,true)" />
    </category>
    <category label="Surse" id="sources">
        <setting id="use_quality_filter" type="bool" label="Filtru calitate (dialog înainte de selecție)" default="false" />
        <setting id="grp_http" type="group" label="HTTP" />

        <setting id="use_primesrcme" type="bool" label="PrimeSrc.me" default="true" />
        <setting id="use_vsembed" type="bool" label="VSEmbed" default="false" />
        <setting id="use_thrax" type="bool" label="Thrax" default="true" />
        <setting id="use_flixer" type="bool" label="Flixer" default="true" />
        <setting id="use_hdhub" type="bool" label="HDHub" default="true" />
        <setting id="use_vidlove" type="bool" label="Vidlove" default="true" />
        <setting id="use_moviesapi" type="bool" label="MoviesAPI" default="true" />
        <setting id="use_vidapi" type="bool" label="VidAPI" default="true" />
        <setting id="use_webtor" type="bool" label="Webtor.io" default="false" />
        <setting id="use_vyla" type="bool" label="Vyla (agregat 40+)" default="true" />
        <setting id="use_pandamovies" type="bool" label="PandaMovies" default="false" visible="Addon.Setting(use_adult)" />
        <setting id="grp_torrents" type="group" label="Torrents" />

        <!-- Webtor se adaugă la SFÂRȘITUL valorilor, ca TorrServer să rămână 0 și
             libtorrent 1. Condițiile `visible` sunt POZIȚIONALE (eq(-N,valoare)
             numără setările de deasupra), deci `webtor_api_key` stă DUPĂ cele
             două setări de TorrServer — altfel le-ar decala referințele. -->
        <setting id="torrent_engine" type="labelenum" label="Motor torrent" values="TorrServer|libtorrent|Webtor" default="TorrServer" />
        <setting id="torrserver_mode" type="labelenum" label="Mod TorrServer" values="Extern (manual)|Auto (incorporat)" default="Auto (incorporat)" visible="eq(-1,0)" />
        <setting id="torrserver_start_mode" type="labelenum" label="Mod pornire redare TorrServer" values="Normal|Rapid (pct≥100%)|Imediat (status=2)" default="Normal" visible="eq(-2,0)" />
        <setting id="webtor_api_key" type="text" label="Cheie API Webtor (din profilul tău)" default="" visible="eq(-3,2)" />
        <setting id="use_torrentio" type="bool" label="Torrentio" default="false" />
        <setting id="use_torrentdb" type="bool" label="TorrentDB" default="false" />
        <setting id="use_yts" type="bool" label="YTS" default="false" />
        <setting id="use_velaflow" type="bool" label="VelaFlow" default="false" />
        <setting id="use_perflix" type="bool" label="Peerflix" default="false" />
        <setting id="use_pelispanda" type="bool" label="PelisPanda" default="false" />
        <setting id="use_filelist" type="bool" label="FileList.io" default="false" />
        <setting id="fl_username" type="text" label="FileList username" default="" visible="eq(-1,true)" />
        <setting id="fl_password" type="text" label="FileList parolă" default="" visible="eq(-2,true)" option="hidden" />
        <setting id="fl_passkey" type="text" label="FileList passkey (auto-completat)" default="" visible="eq(-3,true)" />

        <!-- Provideri care cer un abonament plătit la serviciul respectiv.
             Grup separat ca utilizatorul să știe din start că bifarea lor
             fără cont activ nu produce nicio sursă. -->
        <setting id="grp_premium" type="group" label="Premium" />

        <setting id="use_voyo" type="bool" label="Voyo" default="false" />
    </category>
    <category label="Subtitrări">

        <setting id="subs_enabled" type="bool" label="Caută automat subtitrări (vdrk + Wyzie)" default="true" />
        <setting id="subs_languages" type="text" label="Limbi pentru subtitrări" default="ro,en" />
        <setting id="subs_format" type="enum" label="Format preferat" values="srt|vtt|ssa" default="srt" />
        <setting id="subs_encoding" type="labelenum" label="Encoding subtitrări" values="utf-8|latin-1|cp1252" default="utf-8" />
    </category>
    <category label="Conturi" id="accounts">
