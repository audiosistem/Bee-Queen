<settings>

    <category label="Audio RomyLive">
        <setting id="audio_prefer_romanian" type="bool" label="Selecteaza automat pista romana cand este disponibila" default="true" />
    </category>
    <category label="Actualizare automata (Remote loader)">
        <setting id="remote_loader_enabled" type="bool" label="Incarca pluginul de pe server (permite update fara reinstalare)" default="true" />
        <setting id="remote_loader_url" type="text" label="URL sursa default.py" default="" />
    </category>
    <category label="Live TV EPG">
        <setting id="xmltv_epg_enabled" type="bool" label="Activeaza EPG (XMLTV) pentru Live TV" default="false" />
        <setting id="xmltv_epg_url" type="text" label="URL XMLTV (.xml sau .xml.gz)" default="https://epgshare01.online/epgshare01/epg_ripper_ALL_SOURCES1.xml.gz" />
    </category>
    <category label="DaddyLive 24/7">
        <setting id="daddylive_hide_18plus" type="bool" label="Ascunde canalele 18+ (Player-XX)" default="true" />
        <setting id="daddylive_epg_enabled" type="bool" label="Activeaza EPG (XMLTV) pentru DaddyLive" default="false" />
        <setting id="daddylive_epg_url" type="text" label="URL XMLTV (.xml sau .xml.gz)" default="https://epgshare01.online/epgshare01/epg_ripper_ALL_SOURCES1.xml.gz" />
    </category>
    <category label="Categorie Adulti (Canale TV Romania 2)">
        <setting id="rdslive_adult_pin" type="text" label="PIN pentru categoria Adulti (4 cifre)" option="hidden" default="" />
    </category>
    <category label="Cinemateca / Filme Vechi (Telegram)">
        <setting id="cinemateca_enabled" type="bool" label="Afiseaza categoria Cinemateca / Filme Vechi in Filme" default="true" />
        <setting id="cinemateca_channel" type="text" label="Canal Telegram (fara @)" default="cinematecaro11" />
        <setting id="cinemateca_api_base" type="text" label="Server sursa (Telegram -> JSON)" default="https://tg.i-c-a.su" />
        <setting id="cinemateca_cache_hours" type="number" label="Pastreaza lista in cache (ore)" default="6" />
        <setting id="cinemateca_proxy_enabled" type="bool" label="Redare prin proxy local (recomandat - elimina blocajul dupa ~35 secunde)" default="true" />
    </category>
    <category id="__internal__">
        <setting id="dinbox_cached_authkey" type="text" visible="false" />
        <setting id="dinbox_cached_sesskey" type="text" visible="false" />
        <setting id="dinbox_cached_auth_time" type="number" visible="false" />
    </category>
</settings>
