<addon id="plugin.video.samus" name="Samus" version="0.0.29" provider-name="derzis">
    <requires>
        <import addon="xbmc.python" version="3.0.0" />
        <import addon="script.module.requests" />
        <import addon="script.module.pycryptodome" />
        <import addon="script.module.beautifulsoup4"/>
        <import addon="script.module.resolveurl"/>
        <import addon="script.module.torrserver"/>
        <import addon="script.module.libtorrent"/>
        <import addon="inputstream.adaptive"/>
        <import addon="script.module.yt-dlp"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary>Samus</summary>
        <description>Samus video addon</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.webp</fanart>
        </assets>
    </extension>
</addon>
