								<scroll>true</scroll>
								<font>font12</font>
								<textcolor>FF4a4347</textcolor>
								<aligny>center</aligny>
								<label>[UPPERCASE]$INFO[ListItem.Property(tikiskins.dialog.line1)][/UPPERCASE]</label>
								<visible>String.IsEmpty(ListItem.Property(tikiskins.check_status))</visible>
							</control>
							<control type="label">
								<scroll>true</scroll>
