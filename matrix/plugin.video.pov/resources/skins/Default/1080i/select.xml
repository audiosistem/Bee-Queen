<?xml version="1.0" encoding="UTF-8"?>
<window>
	<controls>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture>black.png</texture>
			<animation type="WindowOpen" reversible="false">
				<effect type="fade" start="0" end="80" time="200" tween="sine" easing="in" />
			</animation>
		</control>
		<control type="group">
			<animation type="WindowOpen" reversible="false">
				<effect type="zoom" start="50" end="100" time="200" center="auto" tween="quadratic" easing="out" />
			</animation>
			<centerleft>75%</centerleft>
			<centertop>50%</centertop>
			<width>620</width>
			<height>800</height>
			<control type="group">
				<visible>!String.IsEqual(Window.Property(tikiskins.dialog.multi_choice),true)</visible>
				<control type="image">
					<texture colordiffuse="CC343434">white.png</texture>
				</control>
				<control type="image">
					<left>10</left>
					<top>10</top>
					<width>50</width>
					<height>50</height>
					<align>left</align>
					<aligny>center</aligny>
					<aspectratio aligny="top">keep</aspectratio>
					<texture>$INFO[Window.Property(tikiskins.pov.icon)]</texture>
				</control>
				<control type="label">
					<centerleft>50%</centerleft>
					<width max="490">auto</width>
					<height>70</height>
					<font>font12</font>
					<textcolor>FFCCCCCC</textcolor>
					<align>center</align>
					<aligny>center</aligny>
					<scroll>true</scroll>
					<label>[UPPERCASE][B]$INFO[Window.Property(tikiskins.dialog.heading)][/B][/UPPERCASE]</label>
				</control>
			</control>
			<control type="group">
				<visible>String.IsEqual(Window.Property(tikiskins.dialog.multi_choice),true)</visible>
