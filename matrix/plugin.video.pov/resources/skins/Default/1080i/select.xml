				<control type="scrollbar" id="2065">
					<visible>Control.IsVisible(2025)</visible>
					<left>10r</left>
					<width>10</width>
					<texturesliderbackground colordiffuse="FF302F2F">white.png</texturesliderbackground>
					<texturesliderbar colordiffuse="FF555556">white.png</texturesliderbar>
					<texturesliderbarfocus colordiffuse="FFB7B4BB">white.png</texturesliderbarfocus>
					<onleft>2025</onleft>
					<onright>11</onright>
