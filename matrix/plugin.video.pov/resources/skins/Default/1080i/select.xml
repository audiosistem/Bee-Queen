								<height>5</height>
								<font>font12</font>
								<textcolor>FF4a4347</textcolor>
								<aligny>center</aligny>
								<label>[UPPERCASE][B]$INFO[ListItem.Property(tikiskins.dialog.line1)][/B][/UPPERCASE]</label>
