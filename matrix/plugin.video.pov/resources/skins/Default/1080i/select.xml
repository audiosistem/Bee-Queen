					<scroll>true</scroll>
					<label>[UPPERCASE][B]$INFO[Window.Property(tikiskins.dialog.heading)][/B][/UPPERCASE]</label>
				</control>
			</control>
			<control type="grouplist">
				<visible>String.IsEqual(Window.Property(tikiskins.dialog.multi_choice),true)</visible>
				<orientation>vertical</orientation>
				<itemgap>20</itemgap>
				<left>-80</left>
				<top>70</top>
				<width>90</width>
				<align>top</align>
				<control type="button" id="10">
					<description>OK</description>
					<top>0</top>
					<width>80</width>
					<height>80</height>
					<onup>11</onup>
					<ondown>11</ondown>
					<onleft>2065</onleft>
					<onright>2025</onright>
					<!--label>[B]OK[/B]</label-->
					<font>font12</font>
					<textcolor>FFB7B4BB</textcolor>
					<focusedcolor>$INFO[Window.Property(tikiskins.dialog.highlight)]</focusedcolor>
					<texturefocus colordiffuse="$INFO[Window.Property(tikiskins.dialog.highlight)]">next_episodes.png</texturefocus>
					<texturenofocus colordiffuse="FFCCCCCC">next_episodes.png</texturenofocus>
					<align>center</align>
					<aligny>center</aligny>
				</control>
				<control type="button" id="11">
					<description>Cancel</description>
					<top>0</top>
					<width>80</width>
					<height>80</height>
