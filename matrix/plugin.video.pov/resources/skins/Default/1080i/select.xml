					<font>font12</font>
					<textcolor>FFB7B4BB</textcolor>
					<focusedcolor>$INFO[Window.Property(tikiskins.dialog.highlight)]</focusedcolor>
					<texturefocus flipx="true" colordiffuse="$INFO[Window.Property(tikiskins.dialog.highlight)]">next_episodes.png</texturefocus>
