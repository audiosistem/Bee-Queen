<?xml version="1.0" encoding="UTF-8"?>
<window>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF000000">redlight_common/white.png</texture>
            <animation effect="fade" end="85" time="120">WindowOpen</animation>
        </control>
        <control type="group">
            <left>280</left>
            <top>50</top>
            <animation effect="fade" end="100" time="200">WindowOpen</animation>
            <control type="group">
                <control type="image">
                    <width>1358</width>
                    <height>978</height>
                    <texture colordiffuse="$INFO[Window(10000).Property(redlight.window_theme)]" border="30">redlight_common/circle.png</texture>
                </control>
                <control type="image">
                    <left>15</left>
                    <top>15</top>
                    <width>70</width>
                    <height>70</height>
                    <align>left</align>
                    <aspectratio aligny="top">keep</aspectratio>
                    <texture>$INFO[Window(10000).Property(redlight.addon_icon_mini)]</texture>
                </control>
                <control type="label">
                    <top>40</top>
                    <left>105</left>
                    <width max="1115">auto</width>
                    <height>20</height>
                    <font>font14</font> <!-- REDLIGHT_33 -->
                    <textcolor>FFCCCCCC</textcolor>
                    <shadowcolor>FF000000</shadowcolor>
                    <align>center</align>
                    <aligny>center</aligny>
                    <label>[B]$INFO[Window.Property(heading)][/B]</label>
                </control>
                <control type="list" id="2000">
                    <pagecontrol>4000</pagecontrol>
                    <left>45</left>
                    <top>114</top>
                    <width>1234</width>
                    <height>800</height>
                    <itemlayout height="40">
                        <control type="label">
                            <visible>String.IsEqual(Window.Property(font_size),large)</visible>
                            <left>10</left>
                            <top>0</top>
                            <width>1214</width>
                            <height>40</height>
                            <font>font14</font> <!-- REDLIGHT_33 -->
                            <label>$INFO[ListItem.Property(line1)]</label>
                            <scroll>false</scroll>
                        </control>
                        <control type="label">
                            <visible>String.IsEqual(Window.Property(font_size),small)</visible>
                            <left>10</left>
                            <top>0</top>
                            <width>1214</width>
                            <height>40</height>
                            <font>font12</font> <!-- REDLIGHT_26 -->
                            <label>$INFO[ListItem.Property(line1)]</label>
                            <scroll>false</scroll>
                        </control>
                    </itemlayout>
                    <focusedlayout height="40">
                        <control type="label">
                            <visible>String.IsEqual(Window.Property(font_size),large)</visible>
                            <left>10</left>
                            <top>0</top>
                            <width>1214</width>
                            <height>40</height>
                            <font>font14</font> <!-- REDLIGHT_33 -->
                            <label>$INFO[ListItem.Property(line1)]</label>
                            <scroll>false</scroll>
                        </control>
                        <control type="label">
                            <visible>String.IsEqual(Window.Property(font_size),small)</visible>
                            <left>10</left>
                            <top>0</top>
                            <width>1214</width>
                            <height>40</height>
                            <font>font12</font> <!-- REDLIGHT_26 -->
                            <label>$INFO[ListItem.Property(line1)]</label>
                            <scroll>false</scroll>
                        </control>
                    </focusedlayout>
                </control>
                <control type="scrollbar" id="4000">
                    <left>1310</left>
                    <top>110</top>
                    <width>32</width>
                    <height>820</height>
                    <texturesliderbackground colordiffuse="FF1F2020">redlight_common/white.png</texturesliderbackground>
                    <texturesliderbar colordiffuse="FF555556">redlight_common/white.png</texturesliderbar>
                    <texturesliderbarfocus colordiffuse="FFCCCCCC">redlight_common/white.png</texturesliderbarfocus>
                    <textureslidernib colordiffuse="FF555556">redlight_common/scrollbar_nib.png</textureslidernib>
                    <textureslidernibfocus colordiffuse="FFCCCCCC">redlight_common/scrollbar_nib.png</textureslidernibfocus>
                    <onleft>4000</onleft>
                    <onright>4000</onright>
                    <showonepage>false</showonepage>
                    <orientation>vertical</orientation>
                </control>
            </control>
        </control>
    </controls>
</window>
