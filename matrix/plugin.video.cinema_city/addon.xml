<?xml version="1.0" encoding="UTF-8"?>
<addon id="plugin.video.cinema_city" version="0.1.0" name="Cinema City" provider-name="Cinema City">
    <requires>
        <import addon="xbmc.python" version="3.0.1"/>
        <import addon="script.module.requests" version="2.22.0"/>
        <import addon="inputstream.adaptive" version="20.3.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="cinema.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="ro">Cinema City - Streaming România 2026</summary>
        <description lang="ro">Addon modular pentru filme și seriale cu subtitrări.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
