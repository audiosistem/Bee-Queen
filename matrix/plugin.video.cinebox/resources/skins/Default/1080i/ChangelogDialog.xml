<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">2060</defaultcontrol>

    <controls>
        <!-- Background -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF000000">white.png</texture>
            <animation effect="fade" end="80" time="120">WindowOpen</animation>
            <animation effect="fade" start="80" end="0" time="120">WindowClose</animation>
        </control>

        <!-- Main container -->
        <control type="group">
            <left>280</left>
            <top>50</top>
            <animation effect="fade" end="100" time="200">WindowOpen</animation>
            <animation effect="zoom" start="90" end="100" center="auto" time="200">WindowOpen</animation>

            <control type="group">
                <!-- Border -->
                <control type="image">
                    <left>-2</left>
                    <top>-2</top>
                    <width>1362</width>
                    <height>982</height>
                    <texture colordiffuse="FFCCCCCC" border="30">circle.png</texture>
                </control>

                <!-- Background -->
                <control type="image">
                    <width>1358</width>
                    <height>978</height>
                    <texture colordiffuse="FF1F2020" border="30">circle.png</texture>
                </control>

                <!-- Icon -->
                <control type="image">
                    <left>15</left>
                    <top>15</top>
                    <width>70</width>
                    <height>70</height>
                    <aspectratio>keep</aspectratio>
                    <texture>icon.png</texture>
                </control>

                <!-- Title -->
                <control type="label">
                    <top>40</top>
                    <left>105</left>
                    <width max="1115">auto</width>
                    <height>20</height>
                    <font>font14</font>
                    <textcolor>FFCCCCCC</textcolor>
                    <shadowcolor>FF000000</shadowcolor>
                    <align>center</align>
                    <aligny>center</aligny>
                    <label>[B]$INFO[Window.Property(heading)][/B]</label>
                </control>

                <!-- TEXTBOX SMALL -->
                <control type="textbox" id="2000">
                    <visible>String.IsEqual(Window.Property(font_size),small) | String.IsEmpty(Window.Property(font_size))</visible>
                    <left>45</left>
                    <top>114</top>
                    <width>1254</width>
                    <height>816</height>
                    <font>font12</font>
                    <textcolor>FFCCCCCC</textcolor>
                    <label>$INFO[Window.Property(text)]</label>

                    <pagecontrol>2060</pagecontrol>

                    <onright>2060</onright>
                    <onup>PageUp</onup>
                    <ondown>PageDown</ondown>

                    <scrolltime>200</scrolltime>
                    <scrollspeed>200</scrollspeed>
                    <smoothscroll>true</smoothscroll>
                    <autoscroll>false</autoscroll>
                </control>

                <!-- SCROLLBAR SMALL -->
                <control type="scrollbar" id="2060">
                    <visible>Control.IsVisible(2000)</visible>
                    <left>1335</left>
                    <top>110</top>
                    <width>10</width>
                    <height>820</height>
                    <texturesliderbackground colordiffuse="FF1F2020">white.png</texturesliderbackground>
                    <texturesliderbar colordiffuse="FF555556">white.png</texturesliderbar>
                    <texturesliderbarfocus colordiffuse="FFCCCCCC">white.png</texturesliderbarfocus>
                    <onleft>2000</onleft>
                    <showonepage>false</showonepage>
                    <orientation>vertical</orientation>
                </control>

                <!-- TEXTBOX LARGE -->
                <control type="textbox" id="2001">
                    <visible>String.IsEqual(Window.Property(font_size),large)</visible>
                    <left>45</left>
                    <top>114</top>
                    <width>1254</width>
                    <height>816</height>
                    <font>font14</font>
                    <textcolor>FFCCCCCC</textcolor>
                    <label>$INFO[Window.Property(text)]</label>

                    <pagecontrol>2061</pagecontrol>

                    <onright>2061</onright>
                    <onup>PageUp</onup>
                    <ondown>PageDown</ondown>

                    <scrolltime>200</scrolltime>
                    <scrollspeed>200</scrollspeed>
                    <smoothscroll>true</smoothscroll>
                    <autoscroll>false</autoscroll>
                </control>

                <!-- SCROLLBAR LARGE -->
                <control type="scrollbar" id="2061">
                    <visible>Control.IsVisible(2001)</visible>
                    <left>1335</left>
                    <top>110</top>
                    <width>10</width>
                    <height>820</height>
                    <texturesliderbackground colordiffuse="FF1F2020">white.png</texturesliderbackground>
                    <texturesliderbar colordiffuse="FF555556">white.png</texturesliderbar>
                    <texturesliderbarfocus colordiffuse="FFCCCCCC">white.png</texturesliderbarfocus>
                    <onleft>2001</onleft>
                    <showonepage>false</showonepage>
                    <orientation>vertical</orientation>
                </control>
            </control>
        </control>
    </controls>
</window>
