<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol>400</defaultcontrol>
    <onback>Close</onback>
    <animation effect="slide" start="0,1080" end="0,0" time="400">WindowOpen</animation>
<animation effect="fade" start="0" end="100" time="400">WindowOpen</animation>


    <controls>
        <control type="image">
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF101010">AddonWindow/black.png</texture>
        </control>
        <control type="image">
            <aspectratio>scale</aspectratio>
            <width>1920</width>
            <height>1080</height>
            <texture>$INFO[Window.Property(backdrop)]</texture>
            <colordiffuse>50FFFFFF</colordiffuse>
        </control>
        <control type="image">
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="88000000">AddonWindow/white.png</texture>
            <gradient orientation="vertical" start="00000000" end="FF000000" />
        </control>

        <!-- POSTER -->
        <control type="image" id="200">
            <top>80</top>
                    <left>1250</left>
                    <width>650</width>
                    <height>950</height>
            <aspectratio aligny="top">stretch</aspectratio>
            <texture diffuse="cinebox_diffuse/poster_w217_h320.png">$INFO[Window.Property(poster)]</texture>
            <effect type="shadow" color="66000000" blur="20" />
            <!-- Animações de abertura --> <animation effect="slide" start="1920,0" end="0,0" time="500">WindowOpen</animation> <animation effect="fade" start="0" end="100" time="500">WindowOpen</animation> <!-- Animações de fechamento --> <animation effect="slide" start="0,0" end="1920,0" time="400">WindowClose</animation> <animation effect="fade" start="100" end="0" time="400">WindowClose</animation>
        </control>

        <!-- CONTEÚDO PRINCIPAL -->
        <control type="group">
            <left>100</left>
            <top>80</top>
            <width>1100</width>

            <!-- TÍTULO/LOGO -->
            <control type="group">
                <height>250</height>
                <left>150</left>
                <top>-150</top>
                <control type="image">
                    <width>800</width>
                    <height>200</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$INFO[Window.Property(clearlogo)]</texture>
                    <visible>!IsEmpty(Window.Property(clearlogo))</visible>
                    <!-- Sem animação - Logo fixo --> <animation effect="fade" start="0" end="100" time="500">WindowOpen</animation> <!-- Animações de fechamento --> <animation effect="fade" start="100" end="0" time="400">WindowClose</animation>
                </control>
                <control type="label" id="100">
                    <width>1100</width>
                    <height>70</height>
                    <font>font60</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <wrapmultiline>true</wrapmultiline>
                    <label>$INFO[Window.Property(title)]</label>
                    <visible>IsEmpty(Window.Property(clearlogo))</visible>
                </control>
            </control>

            <!-- ANO + DURAÇÃO -->
            <control type="label" id="103">
                <top>200</top>
                <width>1100</width>
                <height>30</height>
                <font>font14</font>
                <textcolor>FFCCCCCC</textcolor>
                <align>left</align>
                <label>$INFO[Window.Property(year)] • $INFO[Window.Property(duration)]</label>
            </control>

