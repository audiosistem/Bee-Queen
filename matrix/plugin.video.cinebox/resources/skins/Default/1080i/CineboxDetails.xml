                    <label>$INFO[Window.Property(Genre.1.Label)]</label>
                    <font>font12</font>
                    <align>center</align>
                    <textoffsetx>15</textoffsetx>
                    <textoffsety>-1</textoffsety>
                    <texturefocus border="15" colordiffuse="FF00AEEF">panel.png</texturefocus>
                    <texturenofocus border="15" colordiffuse="FF282828">panel.png</texturenofocus>
                    <textcolor>FFFFFFFF</textcolor>   
                    <focusedcolor>FF000000</focusedcolor>
                    <animation effect="zoom" start="95" end="100" center="auto" time="150">Focus</animation>
                    <onup>999</onup>
                    <onleft>999</onleft>
                    <ondown>501</ondown>
