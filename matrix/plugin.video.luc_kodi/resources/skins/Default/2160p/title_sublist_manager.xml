				<texturenofocus>common/button5.png</texturenofocus>
				<label>$ADDON[plugin.video.luc_kodi 32170]</label>
				<font>font12</font>
				<align>center</align>
				<textcolor>white</textcolor>
				<focusedcolor>white</focusedcolor>
			</control>
		</control>

		<control type="group" id="1">
