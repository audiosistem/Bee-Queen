				<height>1600</height>
			</control>
			<control type="progress" id="2046">
				<top>1600</top>
				<left>0</left>
				<width>2700</width>
				<height>14</height>
				<reveal>true</reveal>
				<texturebg colordiffuse="FF302F2F">common/white.png</texturebg>
				<midtexture colordiffuse="FFFF4081">common/white.png</midtexture>
			</control>
			<control type="button" id="2045">
