				<font>font14</font>
				<textcolor>white</textcolor>
				<align>left</align>
				<aligny>bottom</aligny>
				<autoscroll>false</autoscroll>
				<label>[COLOR $INFO[Window().Property(luc_kodi.highlight.color)]]$INFO[Window().Property(luc_kodi.total_results)] Total Title Substitute Items[/COLOR]</label>
			</control>

