				<width>260</width>
				<height>80</height>
				<font>font14</font>
				<textcolor>white</textcolor>
				<align>left</align>
				<aligny>bottom</aligny>
				<autoscroll>false</autoscroll>
				<label>[COLOR $INFO[Window().Property(luc_kodi.highlight.color)]]Remove[/COLOR]</label>
			</control>
