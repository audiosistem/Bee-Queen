<?xml version="1.0" encoding="UTF-8"?>
<!--
	luc_kodi — Unified notification card
	Position : bottom-right  left=1322  top=932  (1920x1080 coordinate space)
	Card size: 580 x 130 px  — corner radius 18px (notif_card.png)
	Icon     : 96x96 keep-aspect (plugin icon 819x819)
	Line 1   : title   — luc_kodi green  #ff00fa9a  font13
	Line 2   : message — gold            #fffdb515  font12  (wraps if needed)
	Animation: slides in from right edge, fades out on close
-->
<window>
	<defaultcontrol always="true">9601</defaultcontrol>
	<controls>
		<control type="group">

			<!-- ── Slide from right edge, fade out ── -->
			<animation type="WindowOpen" reversible="false">
				<effect type="fade"  start="0"    end="100"  time="340" />
				<effect type="slide" start="600,0" end="0,0" time="340" tween="sine" easing="out" />
			</animation>
			<animation type="WindowClose" reversible="false">
				<effect type="fade"  start="100" end="0"    time="280" />
				<effect type="slide" start="0,0" end="600,0" time="280" tween="sine" easing="in" />
			</animation>

			<!-- ── Card: 580 x 130 — bottom-right, 18px margins ── -->
			<control type="group">
				<top>932</top>
				<left>1322</left>
				<width>580</width>
				<height>130</height>

				<!-- Background: dark semi-transparent, true rounded corners -->
				<control type="image">
					<top>0</top><left>0</left>
					<width>580</width><height>130</height>
					<texture colordiffuse="E8101010">common/notif_card.png</texture>
				</control>

				<!-- Left accent bar — clipped to stay within rounded corners -->
				<!-- Uses a narrower rounded rect approach: starts at x=0, width=8 -->
				<!-- The card bg already clips the visual so left corners stay round -->
				<control type="image">
					<top>10</top><left>0</left>
					<width>5</width><height>110</height>
					<texture colordiffuse="FF00FA9A">common/white.png</texture>
				</control>

				<!-- Plugin icon — 96x96, keep aspect ratio, vertically centred -->
				<control type="image">
					<top>17</top><left>16</left>
					<width>96</width><height>96</height>
					<aspectratio>keep</aspectratio>
					<texture>$INFO[Window(10000).Property(luc_kodi.notif.icon)]</texture>
				</control>

				<!-- Line 1: title — luc_kodi green #ff00fa9a -->
				<control type="label">
					<top>22</top><left>126</left>
					<width>442</width><height>36</height>
					<font>font13</font>
					<textcolor>FFFFFFFF</textcolor>
					<label>$INFO[Window(10000).Property(luc_kodi.notif.line1)]</label>
					<align>left</align>
					<aligny>center</aligny>
				</control>

				<!-- Line 2: message — gold #fffdb515, wraps if long -->
				<control type="label">
					<top>64</top><left>126</left>
					<width>442</width><height>52</height>
					<font>font12</font>
					<textcolor>FFFDB515</textcolor>
					<label>$INFO[Window(10000).Property(luc_kodi.notif.line2)]</label>
					<align>left</align>
					<aligny>top</aligny>
					<wrapmultiline>true</wrapmultiline>
				</control>

			</control>
		</control>
	</controls>
</window>
