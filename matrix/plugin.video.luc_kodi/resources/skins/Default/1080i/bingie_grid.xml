<?xml version="1.0" encoding="utf-8"?>
<!--
	luc_kodi  ·  Bingie-style content grid (modern ui)
	Spotlight hero (clearlogo + year/runtime/genres + plot + ratings) on the left,
	poster grid (true 2:3 posters) on the right.  Skin-independent.
	Coordinates are 1080 (1920 x 1080), generated from 2160p by /2.
-->
<window>
	<defaultcontrol always="true">5000</defaultcontrol>
	<onload>SetProperty(luc_kodi.bingie.loaded,1)</onload>
	<controls>

		<!-- ===================== BACKGROUND (full screen, uniform) ===================== -->
		<!-- fanart fills the entire screen -->
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<aspectratio>scale</aspectratio>
			<fadetime>400</fadetime>
			<texture background="true" fallback="common/black.png">$INFO[ListItem.Art(fanart)]</texture>
		</control>
		<!-- one uniform dim across the whole screen -->
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="800A0A12">common/black.png</texture>
		</control>
		<!-- single smooth left-to-right gradient: dark on the hero side,
		     transparent over the poster grid (one texture, no banding) -->
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="FF0A0A12">common/gradient-diffuse-horizontal.png</texture>
		</control>

		<!-- ===================== HEADER ===================== -->
		<control type="label" id="100">
			<left>60</left><top>20</top><width>750</width><height>35</height>
			<label>$INFO[Window.Property(luc_kodi.page_title)]</label>
			<font>font14</font>
			<textcolor>FFFFFFFF</textcolor>
			<shadowcolor>FF000000</shadowcolor>
		</control>
		<control type="label" id="102">
			<left>1560</left><top>28</top><width>300</width><height>20</height>
			<label>$INFO[Window.Property(luc_kodi.total_items)]</label>
			<font>font12</font>
			<textcolor>FF8A8A8A</textcolor>
			<align>right</align>
		</control>

		<!-- ===================== SPOTLIGHT HERO (LEFT) ===================== -->
		<control type="group">
			<left>60</left><top>150</top><width>780</width><height>880</height>
			<visible>Integer.IsGreater(Container(5000).NumItems,0)</visible>
			<animation effect="fade" start="0" end="100" time="300">Visible</animation>

			<!-- clearlogo, fallback to plain title -->
			<control type="image" id="9001">
				<left>0</left><top>0</top><width>500</width><height>180</height>
				<align>left</align>
				<aspectratio align="left" aligny="center">keep</aspectratio>
				<fadetime>350</fadetime>
				<texture background="true" fallback="common/black.png">$INFO[ListItem.Art(clearlogo)]</texture>
				<visible>!String.IsEmpty(ListItem.Art(clearlogo))</visible>
			</control>
			<control type="textbox" id="9002">
				<left>0</left><top>20</top><width>750</width><height>160</height>
				<font>font14</font>
				<align>left</align>
				<aligny>top</aligny>
				<textcolor>FFFFFFFF</textcolor>
				<label>$INFO[ListItem.Label]</label>
				<visible>String.IsEmpty(ListItem.Art(clearlogo))</visible>
			</control>

			<!-- meta line: year - runtime - genres - cert -->
			<control type="label" id="9010">
				<left>2</left><top>200</top><width>770</width><height>26</height>
				<font>font13</font>
				<align>left</align>
				<textcolor>FFCFCFCF</textcolor>
				<label>$INFO[Window.Property(luc_kodi.meta_line)]</label>
			</control>

			<!-- ratings row -->
			<control type="grouplist" id="9020">
				<left>2</left><top>235</top><width>770</width><height>30</height>
				<orientation>horizontal</orientation>
				<itemgap>34</itemgap>
				<align>left</align>
				<usecontrolcoords>true</usecontrolcoords>

				<control type="group">
					<width>90</width><height>28</height>
					<visible>!String.IsEmpty(Window.Property(luc_kodi.rating_imdb))</visible>
					<control type="image">
						<left>0</left><top>4</top><width>20</width><height>20</height>
						<aspectratio>keep</aspectratio>
						<texture>ratings/rating_imdb.png</texture>
					</control>
					<control type="label">
						<left>25</left><top>0</top><width>65</width><height>28</height>
						<font>font13</font><aligny>center</aligny>
						<textcolor>FFEFEFEF</textcolor>
						<label>$INFO[Window.Property(luc_kodi.rating_imdb)]</label>
					</control>
				</control>
				<control type="group">
					<width>90</width><height>28</height>
					<visible>!String.IsEmpty(Window.Property(luc_kodi.rating_rt))</visible>
					<control type="image">
						<left>0</left><top>4</top><width>20</width><height>20</height>
						<aspectratio>keep</aspectratio>
						<texture>ratings/rating_rt.png</texture>
					</control>
					<control type="label">
						<left>25</left><top>0</top><width>65</width><height>28</height>
						<font>font13</font><aligny>center</aligny>
						<textcolor>FFEFEFEF</textcolor>
						<label>$INFO[Window.Property(luc_kodi.rating_rt)]</label>
					</control>
				</control>
				<control type="group">
					<width>90</width><height>28</height>
					<visible>!String.IsEmpty(Window.Property(luc_kodi.rating_tmdb))</visible>
					<control type="image">
						<left>0</left><top>4</top><width>20</width><height>20</height>
						<aspectratio>keep</aspectratio>
						<texture>ratings/rating_tmdb.png</texture>
					</control>
					<control type="label">
						<left>25</left><top>0</top><width>65</width><height>28</height>
						<font>font13</font><aligny>center</aligny>
						<textcolor>FFEFEFEF</textcolor>
						<label>$INFO[Window.Property(luc_kodi.rating_tmdb)]</label>
					</control>
				</control>
				<control type="group">
					<width>90</width><height>28</height>
					<visible>!String.IsEmpty(Window.Property(luc_kodi.rating_trakt))</visible>
					<control type="image">
						<left>0</left><top>4</top><width>20</width><height>20</height>
						<aspectratio>keep</aspectratio>
						<texture>ratings/rating_trakt.png</texture>
					</control>
					<control type="label">
						<left>25</left><top>0</top><width>65</width><height>28</height>
						<font>font13</font><aligny>center</aligny>
						<textcolor>FFEFEFEF</textcolor>
						<label>$INFO[Window.Property(luc_kodi.rating_trakt)]</label>
					</control>
				</control>
			</control>

			<!-- plot: tall box, full text, auto-scrolls when it overflows -->
			<control type="textbox" id="9030">
				<left>2</left><top>280</top><width>750</width><height>550</height>
				<font>font12</font>
				<align>left</align>
				<textcolor>FFD2D2D2</textcolor>
				<label>$INFO[ListItem.Plot]</label>
				<autoscroll delay="6000" time="4000" repeat="8000">true</autoscroll>
			</control>
		</control>

		<!-- ===================== POSTER GRID (RIGHT, true 2:3) ===================== -->
		<!-- 5 columns. card 388 wide; poster 360x540 (2:3). -->
		<control type="panel" id="5000">
			<left>920</left><top>150</top><width>990</width><height>880</height>
			<onleft>5000</onleft>
			<onright>5000</onright>
			<onup>5000</onup>
			<ondown>5000</ondown>
			<viewtype label="Bingie">panel</viewtype>
			<orientation>vertical</orientation>
			<scrolltime tween="sine" easing="out">240</scrolltime>
			<preloaditems>5</preloaditems>
			<pagecontrol>60</pagecontrol>

			<itemlayout width="194" height="300">
				<!-- poster (true 2:3) -->
				<control type="image">
					<left>7</left><top>7</top><width>180</width><height>270</height>
					<aspectratio>scale</aspectratio>
					<texture fallback="common/black.png">$INFO[ListItem.Art(poster)]</texture>
				</control>
				<!-- 'Next page' caption (only on the sentinel card) -->
				<control type="label">
					<left>7</left><top>248</top><width>180</width><height>26</height>
					<align>center</align><aligny>center</aligny>
					<font>font12</font>
					<textcolor>FF00FA9A</textcolor>
					<label>$INFO[ListItem.Label]</label>
					<visible>Integer.IsEqual(ListItem.Property(luc_next_card),1)</visible>
				</control>
				<!-- watched tick -->
				<control type="image">
					<left>161</left><top>13</top><width>22</width><height>22</height>
					<texture colordiffuse="CC00FA9A">common/white.png</texture>
					<visible>Integer.IsEqual(ListItem.Property(luc_watched),1)</visible>
				</control>
				<!-- progress bar -->
				<control type="progress">
					<left>7</left><top>274</top><width>180</width><height>3</height>
					<texturebg colordiffuse="60000000" border="0">common/white.png</texturebg>
					<lefttexture/>
					<midtexture colordiffuse="FF00FA9A" border="0">common/white.png</midtexture>
					<righttexture/>
					<info>ListItem.Property(luc_progress)</info>
					<visible>!String.IsEmpty(ListItem.Property(luc_progress))</visible>
				</control>
			</itemlayout>

			<focusedlayout width="194" height="300">
				<!-- focus glow border -->
				<control type="image">
					<left>4</left><top>4</top><width>186</width><height>276</height>
					<texture colordiffuse="FF00FA9A">common/white.png</texture>
				</control>
				<control type="image">
					<left>7</left><top>7</top><width>180</width><height>270</height>
					<aspectratio>scale</aspectratio>
					<texture fallback="common/black.png">$INFO[ListItem.Art(poster)]</texture>
				</control>
				<!-- 'Next page' caption (only on the sentinel card) -->
				<control type="label">
					<left>7</left><top>248</top><width>180</width><height>26</height>
					<align>center</align><aligny>center</aligny>
					<font>font12</font>
					<textcolor>FF00FA9A</textcolor>
					<label>$INFO[ListItem.Label]</label>
					<visible>Integer.IsEqual(ListItem.Property(luc_next_card),1)</visible>
				</control>
				<control type="image">
					<left>161</left><top>13</top><width>22</width><height>22</height>
					<texture colordiffuse="CC00FA9A">common/white.png</texture>
					<visible>Integer.IsEqual(ListItem.Property(luc_watched),1)</visible>
				</control>
				<control type="progress">
					<left>7</left><top>274</top><width>180</width><height>3</height>
					<texturebg colordiffuse="60000000" border="0">common/white.png</texturebg>
					<lefttexture/>
					<midtexture colordiffuse="FF00FA9A" border="0">common/white.png</midtexture>
					<righttexture/>
					<info>ListItem.Property(luc_progress)</info>
					<visible>!String.IsEmpty(ListItem.Property(luc_progress))</visible>
				</control>
				<animation effect="zoom" end="105,105" center="auto" time="120" tween="sine">focus</animation>
			</focusedlayout>
		</control>

		<!-- vertical scrollbar -->
		<control type="scrollbar" id="60">
			<left>1903</left><top>150</top><width>5</width><height>880</height>
			<orientation>vertical</orientation>
			<onleft>5000</onleft>
			<visible>Integer.IsGreater(Container(5000).NumItems,0)</visible>
		</control>

		<!-- page indicator (top-area, under the count) — paging is done by
		     selecting the "Next page" card in the grid; Back goes one page back.
		     Works the same with touch and remote. -->
		<control type="label" id="103">
			<left>60</left><top>52</top><width>750</width><height>22</height>
			<font>font12</font>
			<textcolor>FF8A8A8A</textcolor>
			<label>$INFO[Window.Property(luc_kodi.total_items)]</label>
		</control>

		<!-- loading indicator (brief, while fetching the next page) -->
		<control type="label">
			<left>920</left><top>1040</top><width>950</width><height>25</height>
			<font>font12</font><align>center</align>
			<textcolor>FF00FA9A</textcolor>
			<label>· · ·</label>
			<visible>!String.IsEmpty(Window.Property(luc_kodi.loading))</visible>
			<animation effect="fade" start="0" end="100" time="200">Visible</animation>
		</control>

	</controls>
</window>
